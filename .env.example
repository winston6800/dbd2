# Supabase (public - safe to expose in frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails that skip the subscription gate (optional)
VITE_ADMIN_EMAILS=you@example.com

# Stripe (public - safe to expose in frontend, not used yet but reserved)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe (secret - server/Vercel functions only, never expose to frontend)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # The $20 ONE-TIME price ID from your Stripe dashboard
                            # Must be a one-off price - a recurring price is rejected in payment mode

# Supabase (secret - server/Vercel functions only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for Stripe redirect URLs)
APP_URL=https://your-app.vercel.app

# Public site URL, baked into the OG/link-preview tags at build time.
# Must be set for Reddit/Twitter/Slack previews to resolve the image.
VITE_APP_URL=https://your-app.vercel.app
