# ─── Supabase (public — safe in the frontend bundle) ────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails that skip the paywall (optional).
# For the analytics dashboard, the same address must also be inserted into the
# public.admin_emails table — the env var only reveals the link.
VITE_ADMIN_EMAILS=you@example.com

# Comma-separated emails allowed to see the analytics dashboard. Deliberately
# separate from VITE_ADMIN_EMAILS above — skipping the paywall and seeing
# revenue/traffic data are different privileges. Unset hides the link from
# everyone. The real enforcement is the admin_emails table in Supabase; this
# only controls whether the UI link is shown.
VITE_ANALYTICS_EMAILS=you@example.com

# Public site URL, baked into the OG/link-preview tags at build time.
# Must be set for Reddit/Twitter/Slack previews to resolve the image.
VITE_APP_URL=https://your-app.vercel.app

# ─── Stripe mode ───────────────────────────────────────────────────────────────
# Picks which credential set the serverless functions use. Set this to `test` on
# preview deployments and `live` on production; both sets can be configured at
# once, so switching needs no code change.
STRIPE_MODE=test

# Free trial length in days, applied at checkout.
STRIPE_TRIAL_DAYS=3

# ─── Stripe: TEST mode (server only — never expose to the frontend) ────────────
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# Must be a RECURRING price (monthly). A one-off price is rejected in
# subscription mode.
STRIPE_PRICE_ID_TEST=price_...

# ─── Stripe: LIVE mode (server only) ───────────────────────────────────────────
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...
STRIPE_PRICE_ID_LIVE=price_...

# Unsuffixed names are still honoured as a fallback for either mode, so an
# existing single-mode deployment keeps working:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# ─── Supabase (secret — server/Vercel functions only) ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL, used for Stripe redirect URLs
APP_URL=https://your-app.vercel.app

# Enables GET /api/stripe-health?token=... which validates the Stripe config
# (key, mode, price, webhook) without moving money. Leave unset to disable the
# endpoint entirely; set it to any long random string to use it.
HEALTH_CHECK_TOKEN=
